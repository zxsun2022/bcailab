{
  "name": "bcailab",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck && pnpm typecheck:scripts && pnpm typecheck:session-cleanup && pnpm typecheck:grader-spikes",
    "typecheck:grader-spikes": "tsc -p tsconfig.grader-spikes.json --noEmit",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json --noEmit",
    "typecheck:session-cleanup": "tsc -p workers/session-cleanup/tsconfig.json --noEmit",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply bcailab-db --local --persist-to apps/web/.wrangler/state",
    "writing-prompts": "tsx scripts/writing-prompt-seed/cli.ts",
    "benchmark:mapdown": "tsx scripts/mapdown-benchmark.ts",
    "context": "./scripts/context-pack.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:web": "node scripts/verification/verify.mjs web",
    "verify:mapdown": "node scripts/verification/verify.mjs mapdown",
    "verify": "node scripts/verification/verify.mjs all",
    "check:docs": "node scripts/verification/check-docs.mjs",
    "test:integration": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx scripts/testing/writing-reliability.mjs --check",
    "test:browser:fixture": "TSX_TSCONFIG_PATH=apps/web/tsconfig.json node --import tsx scripts/testing/writing-reliability.mjs",
    "verify:failures": "node scripts/verification/check-failures.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260203.0",
    "@eslint/js": "^9.39.5",
    "@types/node": "25.2.0",
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.7",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "26.1.0",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^2.1.9",
    "wrangler": "4.125.0"
  },
  "pnpm": {
    "overrides": {
      "@cloudflare/workers-types": "4.20260203.0",
      "@remix-run/cloudflare": "2.17.4",
      "@remix-run/cloudflare-pages": "2.17.4",
      "@remix-run/dev": "2.17.4",
      "@remix-run/react": "2.17.4",
      "@types/react": "18.3.27",
      "@types/react-dom": "18.3.7",
      "esbuild": "^0.24.0",
      "react": "18.3.1",
      "react-dom": "18.3.1",
      "vite": "5.4.21",
      "wrangler": "4.125.0"
    }
  }
}
