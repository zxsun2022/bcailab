{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mapdown",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": "dist",
  "vars": {
    "WEB_ORIGIN": "https://bcailab.com",
    "MAPDOWN_ORIGIN": "https://map.bcailab.com",
    "PUBLISHED_ORIGIN": "https://share.bcailab.com"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bcailab-db",
      "database_id": "7048b3f2-affb-492a-a9a4-18ab5cd2fc4e",
      "preview_database_id": "8707dea1-f2f7-4a3c-99ee-2245cb63e22c",
      "migrations_dir": "../../migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2",
      "bucket_name": "bcailab-assets",
      "preview_bucket_name": "bcailab-assets-preview"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.01 }
  }
}
